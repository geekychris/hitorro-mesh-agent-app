<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hitorro</groupId>
    <artifactId>hitorro-mesh-agent-app</artifactId>
    <version>3.0.1</version>
    <packaging>jar</packaging>

    <name>hitorro-mesh-agent-app</name>
    <description>Runnable Spring Boot application that hosts a MeshAgent. Reads capabilities and local table registrations from properties/env, picks a transport (NATS or in-memory), and joins the mesh. Deployable as a fat JAR on any host that can reach the NATS server — the same JAR runs on Orion, Kubernetes, systemd, or plain java -jar.</description>

    <properties>
        <hitorro.deploy.repo.path>${user.home}/code/hitorro-maven</hitorro.deploy.repo.path>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <spring-boot.version>3.2.2</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Aggressive exclusions repeated on each hitorro dep. The mesh agent doesn't
        need Hadoop/AWS-SDK/ONNX/Groovy/POI/Lucene/RocksDB/Curator/OpenNLP/Solr/
        Hibernate/PDFBox/BouncyCastle/Jetty — the base hitorro stack pulls them all
        transitively (HDFS/S3 filesystem, NLP classifiers, kvstore, etc.), but a
        mesh worker just needs jvssql + jackson + logback.

        Why on every dep instead of dependencyManagement: Maven applies exclusions
        per-dep-edge; the same transitive can come through multiple paths (mesh-core,
        mesh-agent, mesh-nats all → hitorro-core → hadoop). Missing one lets the
        transitive slip in via the resolver's shortest-path rule. Repetitive but
        reliable. Cost: 400+ lines of XML we didn't have to think about hard.

        Result: 900MB → ~150MB fat jar.
    -->
    <dependencies>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-core</artifactId>
            <version>3.0.1</version>
            <exclusions>
                <!-- Logging conflicts (fought Spring Boot's Logback before). -->
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
                <exclusion><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></exclusion>
                <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
                <!-- Filesystem backends the mesh doesn't use. -->
                <exclusion><groupId>org.apache.hadoop</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.hadoop.thirdparty</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.wildfly.openssl</groupId><artifactId>*</artifactId></exclusion>
                <!-- Coordination not used in phase 1/2 mesh. -->
                <exclusion><groupId>org.apache.curator</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.zookeeper</groupId><artifactId>*</artifactId></exclusion>
                <!-- Alternative servlet container — Spring Boot brings Tomcat. -->
                <exclusion><groupId>org.eclipse.jetty</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.eclipse.jetty.toolchain</groupId><artifactId>*</artifactId></exclusion>
                <!-- Crypto library only needed by Hadoop's Kerberos support. -->
                <exclusion><groupId>org.bouncycastle</groupId><artifactId>*</artifactId></exclusion>
                <!-- Groovy runtime. Mesh doesn't compile Groovy UDFs; if you add
                     Groovy UDFs, re-include groovy-core (~5MB) — not the full groovy-all. -->
                <exclusion><groupId>org.codehaus.groovy</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.jruby</groupId><artifactId>*</artifactId></exclusion>
                <!-- Document format libraries (basedms/features). Not used by mesh. -->
                <exclusion><groupId>org.apache.poi</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.pdfbox</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.xmlbeans</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>com.drewnoakes</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>net.jthink</groupId><artifactId>*</artifactId></exclusion>
                <!-- Old XML-RPC / HTTP libraries. -->
                <exclusion><groupId>org.apache.xmlrpc</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.ws.commons</groupId><artifactId>*</artifactId></exclusion>
                <!-- Mail / SSH / telnet servers baked into hitorro-util. -->
                <exclusion><groupId>com.sun.mail</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.sshd</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>net.wimpi</groupId><artifactId>*</artifactId></exclusion>
                <!-- Redis / netty-tcnative platform binaries. -->
                <exclusion><groupId>io.lettuce</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>io.netty</groupId><artifactId>netty-tcnative-boringssl-static</artifactId></exclusion>
                <!-- Quartz scheduler — mesh has its own heartbeat scheduler. -->
                <exclusion><groupId>org.quartz-scheduler</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-agent</artifactId>
            <version>3.0.1</version>
            <exclusions>
                <!-- Logging conflicts. -->
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
                <exclusion><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></exclusion>
                <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
                <!-- Filesystem backends. -->
                <exclusion><groupId>org.apache.hadoop</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.hadoop.thirdparty</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.wildfly.openssl</groupId><artifactId>*</artifactId></exclusion>
                <!-- Coordination. -->
                <exclusion><groupId>org.apache.curator</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.zookeeper</groupId><artifactId>*</artifactId></exclusion>
                <!-- Jetty. -->
                <exclusion><groupId>org.eclipse.jetty</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.eclipse.jetty.toolchain</groupId><artifactId>*</artifactId></exclusion>
                <!-- Kerberos crypto. -->
                <exclusion><groupId>org.bouncycastle</groupId><artifactId>*</artifactId></exclusion>
                <!-- Scripting (jvssql-side) — mesh doesn't compile Groovy UDFs. -->
                <exclusion><groupId>org.codehaus.groovy</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.jruby</groupId><artifactId>*</artifactId></exclusion>
                <!-- NLP models pulled in by jsontypesystem — not used by mesh. -->
                <exclusion><groupId>org.apache.opennlp</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>com.microsoft.onnxruntime</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>ai.djl.huggingface</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>ai.djl.api</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>net.sf.extjwnl</groupId><artifactId>*</artifactId></exclusion>
                <!-- Document formats. -->
                <exclusion><groupId>org.apache.poi</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.pdfbox</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.xmlbeans</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>com.drewnoakes</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>net.jthink</groupId><artifactId>*</artifactId></exclusion>
                <!-- XML-RPC. -->
                <exclusion><groupId>org.apache.xmlrpc</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.ws.commons</groupId><artifactId>*</artifactId></exclusion>
                <!-- Mail/SSH/telnet. -->
                <exclusion><groupId>com.sun.mail</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.sshd</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>net.wimpi</groupId><artifactId>*</artifactId></exclusion>
                <!-- Redis / netty tcnative. -->
                <exclusion><groupId>io.lettuce</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>io.netty</groupId><artifactId>netty-tcnative-boringssl-static</artifactId></exclusion>
                <!-- Quartz. -->
                <exclusion><groupId>org.quartz-scheduler</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>
        <!-- Agent-side pipeline executor. Autoconfig activates when
             hitorro.mesh.pipelines.enabled=true, subscribing to
             mesh.agent.pipeline.<agentId> and executing each incoming
             NodeSpec via a local JobRunner. Advertises the pipeline-node
             capability so the driver's PipelineScheduler can target this
             agent. -->
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-agent-pipelines</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-pipelines</artifactId>
            <version>3.0.1</version>
        </dependency>
        <!-- Groovy for the groovy-map step; jnats for NATS sink/source
             (already transitively via hitorro-mesh-nats but declared
             explicitly here so the pipelines module can use them). -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>4.0.21</version>
        </dependency>

        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-nats</artifactId>
            <version>3.0.1</version>
            <exclusions>
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
                <exclusion><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></exclusion>
                <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
                <exclusion><groupId>org.apache.hadoop</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.hadoop.thirdparty</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.curator</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.zookeeper</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.eclipse.jetty</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.bouncycastle</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.codehaus.groovy</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.jruby</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>

        <!--
            Streaming source adapters (phase 6b). Bundled so YAML-configured
            kafka: / nats: table entries work out of the box. Both are thin
            wrappers around hitorro-streams-* — adding them here pulls in
            the kafka-clients + jnats deps that back them.
        -->
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-streaming-kafka</artifactId>
            <version>3.0.1</version>
            <exclusions>
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
                <exclusion><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></exclusion>
                <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-streaming-nats</artifactId>
            <version>3.0.1</version>
            <exclusions>
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
                <exclusion><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></exclusion>
                <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
            </exclusions>
        </dependency>

        <!--
             hadoop-common — pulled in JUST for basefile's CompressionType
             static initializer, which references org.apache.hadoop.io
             .compress.BZip2Codec. Every other exclusion in this pom bans
             Hadoop wholesale; we allowlist hadoop-common here and strip
             everything transitive we don't need (HDFS clients, jersey,
             jetty, kerberos, avro, etc). Adds ~4 MB to the fat jar.
             NdjsonLocalTable uses BaseFile.getInputStream() which routes
             the codec dispatch through basefile — same code path any
             future S3/HDFS-backed dataset takes.
        -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <version>3.3.6</version>
            <exclusions>
                <!-- hadoop-shaded-guava kept — Hadoop internals use its
                     CacheLoader inside FileSystem. protobuf can go. -->
                <exclusion><groupId>org.apache.hadoop.thirdparty</groupId><artifactId>hadoop-shaded-protobuf_3_7</artifactId></exclusion>
                <exclusion><groupId>org.apache.hadoop.thirdparty</groupId><artifactId>hadoop-shaded-protobuf_3_21</artifactId></exclusion>
                <exclusion><groupId>org.apache.hadoop.thirdparty</groupId><artifactId>hadoop-shaded-protobuf_3_25</artifactId></exclusion>
                <exclusion><groupId>org.apache.zookeeper</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.curator</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.eclipse.jetty</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.eclipse.jetty.websocket</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>com.sun.jersey</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>javax.servlet</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>javax.servlet.jsp</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.avro</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.apache.kerby</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>com.jcraft</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>com.nimbusds</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.jline</groupId><artifactId>*</artifactId></exclusion>
                <!-- Woodstox kept — Hadoop's Configuration.loadResource
                     uses it to parse core-site.xml etc, even when we
                     never call load(). Excluding it → ClassNotFoundException
                     on com.ctc.wstx.io.InputBootstrapper at load time. -->
                <exclusion><groupId>dnsjava</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>com.google.protobuf</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
                <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
                <exclusion><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></exclusion>
                <exclusion><groupId>org.apache.htrace</groupId><artifactId>*</artifactId></exclusion>
                <exclusion><groupId>org.bouncycastle</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Phase 7m: expose mesh_agent_* metrics via /actuator/prometheus.
             Optional runtime dep — omit if you scrape metrics another way. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Parquet reader for runtime-registered tables (ParquetLocalTable).
             AvroParquetReader → GenericRecord → JVS conversion. Small class,
             big dep footprint — kept scoped to agent-app so agents that
             don't want the +50 MB pull can strip it via <exclusion>. -->
        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-avro</artifactId>
            <version>1.14.3</version>
            <exclusions>
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>1.11.3</version>
        </dependency>
        <!-- hadoop-aws — MinioProtocolAdapter delegates to Hadoop's
             s3a FileSystem for actual I/O. Without this dep, s3:// URIs
             fail with "ClassNotFoundException: S3AFileSystem" at read
             time even though addProtocolAdapter succeeded. Needed for
             the S3AdapterInstaller flow (agent-side S3 hot-switch) and
             any s3:// runtime-registered table. -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-aws</artifactId>
            <version>3.3.6</version>
            <exclusions>
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
            </exclusions>
        </dependency>
        <!-- ParquetReadOptions.Builder statically references
             org.apache.hadoop.mapreduce.lib.input.FileInputFormat.
             Without this dep every ParquetReader construction dies with
             NoClassDefFoundError. ~1 MB. -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-mapreduce-client-core</artifactId>
            <version>3.3.6</version>
            <exclusions>
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
                <exclusion><groupId>org.apache.hadoop</groupId><artifactId>hadoop-yarn-common</artifactId></exclusion>
                <exclusion><groupId>org.apache.hadoop</groupId><artifactId>hadoop-yarn-client</artifactId></exclusion>
                <exclusion><groupId>org.apache.hadoop</groupId><artifactId>hadoop-hdfs-client</artifactId></exclusion>
                <exclusion><groupId>org.codehaus.jettison</groupId><artifactId>jettison</artifactId></exclusion>
                <exclusion><groupId>com.google.inject</groupId><artifactId>guice</artifactId></exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.hitorro.mesh.agent.app.MeshAgentApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>hitorro-local</id>
            <url>file://${hitorro.deploy.repo.path}</url>
        </repository>
    </distributionManagement>
</project>
